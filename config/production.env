# Public production broker configuration packaged with QuizMaster.
# Secrets must stay in the Cloudflare Worker environment, not this desktop repo.
QUIZMASTER_TIKTOK_AUTH_BASE_URL=https://quizmaster-tiktok-auth.stokie-md.workers.dev

# Public widget host. Official OBS browser-source URLs are generated against
# this origin as https://<host>/u/<public_widget_id>/<widget>?session=<id>.
# This is the shared LiveForge widget host, already exposed to the running
# desktop bridge server (http://127.0.0.1:5555) through a Cloudflare Tunnel.
# QuizMaster accounts carry qmw_ ids and are served on the same host -- the
# desktop validates the path id against the signed-in user, not a subdomain.
# See docs/WIDGET_TUNNEL_SETUP.md.
HOSTED_WIDGETS_BASE_URL=https://widgets.liveforge.online
