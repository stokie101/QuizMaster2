# Public production configuration packaged with QuizMaster.
# Secrets must stay in the Cloudflare Worker / website environment, not this desktop repo.
QUIZMASTER_MODE=release
QUIZMASTER_AUTH_MODE=account
URL_MODE=public
WIDGETS_BASE_URL=https://widgets.quizmaster.online
PUBLIC_BASE_URL=https://widgets.quizmaster.online
QUIZMASTER_TIKTOK_AUTH_BASE_URL=https://quizmaster-tiktok-auth.stokie-md.workers.dev
